\citation{paper2309}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Fixed-condition SSPA output fibers.} Each row fixes one transmitted-symbol anchor \(x_i\) and plots \(512\) repeated channel outputs in the first I/Q plane; the three anchors are selected from \(256\) candidate transmitted symbols. The analytic channel is shown in gray. The learned columns overlay generated samples from joint Sinkhorn and condition-wise Sinkhorn on the same analytic cloud. Joint transport can match aspects of the global output distribution while displacing the fixed-\(x\) fiber. Condition-wise Sinkhorn better preserves the conditional output law.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:conditional-fiber-diagnostic}{{1}{9}{\textbf {Fixed-condition SSPA output fibers.} Each row fixes one transmitted-symbol anchor \(x_i\) and plots \(512\) repeated channel outputs in the first I/Q plane; the three anchors are selected from \(256\) candidate transmitted symbols. The analytic channel is shown in gray. The learned columns overlay generated samples from joint Sinkhorn and condition-wise Sinkhorn on the same analytic cloud. Joint transport can match aspects of the global output distribution while displacing the fixed-\(x\) fiber. Condition-wise Sinkhorn better preserves the conditional output law}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces \textbf  {Anchor-conditioned diagnostics for Sinkhorn drift fields.} Anchor SWD and Gaussian Wasserstein-2 (GW2) are computed from repeated samples at fixed channel inputs. Direct SWD and BER/SER are reported separately in Tables~\ref {tab:wflow-swd-baselines} and~\ref {tab:wflow-ser-ber}. Values are seed means. Lower is better.}}{9}{table.6}\protected@file@percent }
\newlabel{tab:wflow-conditional-metrics}{{VI}{9}{\textbf {Anchor-conditioned diagnostics for Sinkhorn drift fields.} Anchor SWD and Gaussian Wasserstein-2 (GW2) are computed from repeated samples at fixed channel inputs. Direct SWD and BER/SER are reported separately in Tables~\ref {tab:wflow-swd-baselines} and~\ref {tab:wflow-ser-ber}. Values are seed means. Lower is better}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Equal wall-clock channel-implant training}{9}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces \textbf  {SSPA condition-wise Sinkhorn budget sensitivity.} The table reports the corrected condition-wise Sinkhorn field under increasing optimizer budgets. Updates are approximate optimizer steps, computed from dataset size, batch size, and epochs. Ratios divide the learned-vs-analytic anchor metric by the analytic-vs-analytic floor. The floor is estimated from two independent analytic channel sample sets at the same anchors. The first two rows are single-seed local diagnostics; the last two rows are aggregated HPC runs. Lower is better.}}{10}{table.7}\protected@file@percent }
\newlabel{tab:sspa-budget-sensitivity}{{VII}{10}{\textbf {SSPA condition-wise Sinkhorn budget sensitivity.} The table reports the corrected condition-wise Sinkhorn field under increasing optimizer budgets. Updates are approximate optimizer steps, computed from dataset size, batch size, and epochs. Ratios divide the learned-vs-analytic anchor metric by the analytic-vs-analytic floor. The floor is estimated from two independent analytic channel sample sets at the same anchors. The first two rows are single-seed local diagnostics; the last two rows are aggregated HPC runs. Lower is better}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces \textbf  {Downstream symbolic coding metrics for Sinkhorn channel surrogates.} Autoencoders are trained through each channel surrogate and evaluated on the analytic channel. Values are mean $\pm $ standard error over seeds. Lower is better. Bold marks the best learned surrogate in each row, while the analytic channel is the non-learned reference training condition.}}{10}{table.8}\protected@file@percent }
\newlabel{tab:wflow-ser-ber}{{VIII}{10}{\textbf {Downstream symbolic coding metrics for Sinkhorn channel surrogates.} Autoencoders are trained through each channel surrogate and evaluated on the analytic channel. Values are mean $\pm $ standard error over seeds. Lower is better. Bold marks the best learned surrogate in each row, while the analytic channel is the non-learned reference training condition}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {SER curves for learned channel surrogates.} Symbolic autoencoders are trained through each surrogate at the nominal point and evaluated on the analytic channel over an $E_b/N_0$ grid. Curves show seed means with standard-error bars; floor-clipped points are upper bounds.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:wflow-all-ser-curves}{{2}{10}{\textbf {SER curves for learned channel surrogates.} Symbolic autoencoders are trained through each surrogate at the nominal point and evaluated on the analytic channel over an $E_b/N_0$ grid. Curves show seed means with standard-error bars; floor-clipped points are upper bounds}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-E}}Long-block TurboAE AWGN check}{11}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Long-block TurboAE AWGN check.} CNN TurboAE models at block length \(64\), rate \(1/2\), are trained through either analytic AWGN or the condition-wise Sinkhorn AWGN surrogate and evaluated on analytic AWGN over \(30\) seeds. The surrogate preserves the waterfall trend with a measurable gap to analytic-channel training.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:turboae-long-block-curve}{{3}{11}{\textbf {Long-block TurboAE AWGN check.} CNN TurboAE models at block length \(64\), rate \(1/2\), are trained through either analytic AWGN or the condition-wise Sinkhorn AWGN surrogate and evaluated on analytic AWGN over \(30\) seeds. The surrogate preserves the waterfall trend with a measurable gap to analytic-channel training}{figure.3}{}}
