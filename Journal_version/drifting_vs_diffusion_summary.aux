\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Long-block TurboAE AWGN check.} CNN TurboAE models are trained at block length \(64\), rate \(1/2\), and \(E_b/N_0=4\,\mathrm  {dB}\), either through the analytic AWGN channel or through the condition-wise Sinkhorn AWGN surrogate. Curves are evaluated on the analytic AWGN channel over \(30\) seeds. The surrogate preserves the qualitative waterfall trend but remains above the analytic-channel training curve.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:turboae-long-block-curve}{{4}{12}{\textbf {Long-block TurboAE AWGN check.} CNN TurboAE models are trained at block length \(64\), rate \(1/2\), and \(E_b/N_0=4\,\mathrm {dB}\), either through the analytic AWGN channel or through the condition-wise Sinkhorn AWGN surrogate. Curves are evaluated on the analytic AWGN channel over \(30\) seeds. The surrogate preserves the qualitative waterfall trend but remains above the analytic-channel training curve}{figure.4}{}}
