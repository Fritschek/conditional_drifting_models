\citation{paper2309}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Fixed-condition SSPA output fibers.} Each row fixes one transmitted-symbol anchor \(x_i\) and plots repeated channel outputs in the first I/Q plane. The analytic channel is shown in gray. The learned columns overlay generated samples from joint Sinkhorn and condition-wise Sinkhorn on the same analytic cloud. Joint transport can match aspects of the global output distribution while displacing the fixed-\(x\) fiber. Condition-wise Sinkhorn better preserves the conditional output law.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:conditional-fiber-diagnostic}{{1}{9}{\textbf {Fixed-condition SSPA output fibers.} Each row fixes one transmitted-symbol anchor \(x_i\) and plots repeated channel outputs in the first I/Q plane. The analytic channel is shown in gray. The learned columns overlay generated samples from joint Sinkhorn and condition-wise Sinkhorn on the same analytic cloud. Joint transport can match aspects of the global output distribution while displacing the fixed-\(x\) fiber. Condition-wise Sinkhorn better preserves the conditional output law}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces \textbf  {Anchor-conditioned diagnostics for W-Flow variants.} Anchor SWD and Gaussian Wasserstein-2 (GW2) are computed from repeated samples at fixed channel inputs. Direct SWD and BER/SER are reported separately in Tables~\ref {tab:wflow-swd-baselines} and~\ref {tab:wflow-ser-ber}. Values are seed means. Lower is better.}}{9}{table.7}\protected@file@percent }
\newlabel{tab:wflow-conditional-metrics}{{VII}{9}{\textbf {Anchor-conditioned diagnostics for W-Flow variants.} Anchor SWD and Gaussian Wasserstein-2 (GW2) are computed from repeated samples at fixed channel inputs. Direct SWD and BER/SER are reported separately in Tables~\ref {tab:wflow-swd-baselines} and~\ref {tab:wflow-ser-ber}. Values are seed means. Lower is better}{table.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Equal wall-clock channel-implant training}{9}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces \textbf  {Downstream symbolic coding metrics for W-Flow channel surrogates.} Autoencoders are trained through each channel surrogate and evaluated on the analytic channel. Values are mean $\pm $ standard error over seeds. Lower is better. Bold marks the best learned surrogate in each row, while the analytic channel is the reference floor.}}{10}{table.8}\protected@file@percent }
\newlabel{tab:wflow-ser-ber}{{VIII}{10}{\textbf {Downstream symbolic coding metrics for W-Flow channel surrogates.} Autoencoders are trained through each channel surrogate and evaluated on the analytic channel. Values are mean $\pm $ standard error over seeds. Lower is better. Bold marks the best learned surrogate in each row, while the analytic channel is the reference floor}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {SER curves for learned channel surrogates.} Symbolic autoencoders are trained through each surrogate at the nominal training point and evaluated on the analytic channel over an $E_b/N_0$ grid for AWGN, Rayleigh, SSPA, and TDL. Curves report seed means with standard-error bars; points below the single-run Monte Carlo resolution are clipped to the dotted reporting floor and marked as upper bounds.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:wflow-all-ser-curves}{{2}{10}{\textbf {SER curves for learned channel surrogates.} Symbolic autoencoders are trained through each surrogate at the nominal training point and evaluated on the analytic channel over an $E_b/N_0$ grid for AWGN, Rayleigh, SSPA, and TDL. Curves report seed means with standard-error bars; points below the single-run Monte Carlo resolution are clipped to the dotted reporting floor and marked as upper bounds}{figure.2}{}}
